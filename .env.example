# Copy to .env (git-ignored). Used only while no admin account exists.
SAGE_BOOTSTRAP_ADMIN_USER=admin
SAGE_BOOTSTRAP_ADMIN_PASSWORD=

# Windows only, required for real SAP RFC calls: root of the SAP NW RFC SDK
# (the folder containing lib/sapnwrfc.dll). Not needed on Linux.
SAPNWRFC_HOME=

# Windows only, optional: local checkout of the pyrfc source (SAP SE's PyRFC
# repo: https://github.com/SAP/PyRFC). If SAPNWRFC_HOME above is set and
# pyrfc isn't already installed, run.bat builds it from here, cloning it
# automatically into sage_api/vendor/pyrfc (git-ignored) if this is unset
# or the folder doesn't exist yet. Leave this whole line out unless you
# want a different location (do not leave it blank; run.bat rejects that).
# PYRFC_SRC=
