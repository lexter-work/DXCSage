# Copy to .env (git-ignored). Used only while no admin account exists.
SAGE_BOOTSTRAP_ADMIN_USER=admin
SAGE_BOOTSTRAP_ADMIN_PASSWORD=

# Windows only, required for real SAP RFC calls: root of the SAP NW RFC SDK
# (the folder containing lib/sapnwrfc.dll). Not needed on Linux.
SAPNWRFC_HOME=

# Windows only, optional: local checkout of the pyrfc source (SAP SE's PyRFC
# repo: https://github.com/SAP/PyRFC). If set, run.bat builds and installs
# pyrfc from here automatically when it isn't already installed.
# A simple option: clone it into sage_api/vendor/pyrfc (already git-ignored)
#   git clone https://github.com/SAP/PyRFC sage_api/vendor/pyrfc
# Leave this whole line out if you don't need it (do not leave it blank;
# run.bat rejects a blank value).
# PYRFC_SRC=sage_api/vendor/pyrfc
